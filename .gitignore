# Python runtime artifacts
**/__pycache__/
*.py[cod]
.pytest_cache/

# ROS/catkin generated workspaces
/ros_ws/build/
/ros_ws/devel/
/ros_ws/install/
/ros_ws/log/

# Local editor settings
/.vscode/

# Large reference manuals are kept locally, outside source control.
/docs/*.pdf
/docs/*.PDF
# Proprietary AnyGrasp license archives stay outside source control.
/docs/license_*.zip

# Runtime products and automatic parameter backups
/Log/
/tool/object_model_builder/output/
/ros_ws/src/arm_vision_framework/config/*.backup_*
/competition_pipeline/output/
/competition_pipeline/config/backups/

# Isolated Gazebo/MoveIt simulation workspace and fetched upstream sources.
/sim/ws/build/
/sim/ws/devel/
/sim/ws/install/
/sim/ws/log/
/sim/ws/.catkin_workspace
/sim/ws/src/CMakeLists.txt
/sim/ws/src/ur5e_robotiq_85_mtc/
/sim/ws/src/moveit_task_constructor/
/sim/logs/
/sim/.*.pid
